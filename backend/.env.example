# Copy this file to .env and fill in real values. Never commit .env.

# Groq LLM (get a key at https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# Optional overrides (defaults shown)
# APP_ENV=development        # set to "production" to disable dev-only features
# PORT=8030
# MAX_UPLOAD_SIZE_MB=10
# MAX_PDF_PAGES=500

# Chunking
# CHUNK_SIZE=800
# CHUNK_OVERLAP=120

# Local embeddings (model is downloaded from Hugging Face once, then cached)
# EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DEVICE=cpu
# EMBEDDING_BATCH_SIZE=32
# EMBEDDING_PRELOAD=true     # load the model in the background at startup

# Vector store (ChromaDB). A relative path is relative to the backend folder.
# CHROMA_PERSIST_DIR=chroma_db
# CHROMA_COLLECTION_NAME=document_chunks
# RETRIEVAL_TOP_K=5
# RETRIEVAL_MAX_TOP_K=20

# Retrieval mode: dense (embeddings), sparse (BM25 keywords) or hybrid (both, merged with RRF).
# /api/ask and /api/search also accept "retrieval_mode" per request to compare them.
# RETRIEVAL_MODE=hybrid
# HYBRID_DENSE_CANDIDATES=20   # candidates each retriever contributes before fusion
# HYBRID_SPARSE_CANDIDATES=20
# RRF_K=60                     # Reciprocal Rank Fusion constant

# RAG answering: retrieved chunks below this similarity are ignored (provisional value),
# unless BM25 found them by an exact keyword match.
# RAG_MIN_SIMILARITY=0.2

# Cohere reranking (get a key at https://dashboard.cohere.com/api-keys). Never commit the key.
# Reranking is on by default when COHERE_API_KEY is set; RERANK_ENABLED overrides that.
# COHERE_API_KEY=your-cohere-api-key-here
# RERANK_ENABLED=true
# RERANK_MODEL=rerank-v5.0-fast   # or rerank-v5.0-pro (more accurate, slower)
# RERANK_CANDIDATES=20             # chunks sent to Cohere; the best RETRIEVAL_TOP_K are kept
# RERANK_TIMEOUT_SECONDS=10
# RERANK_MAX_TOKENS_PER_DOC=512

# Groq limits
# GROQ_TIMEOUT_SECONDS=30
# GROQ_MAX_COMPLETION_TOKENS=2048
# MAX_QUESTION_LENGTH=2000

# Evaluation (python -m evaluation.evaluate_rag): Groq model Ragas uses as the judge.
# A different model family from GROQ_MODEL avoids a model grading its own answers.
# EVAL_JUDGE_MODEL=qwen/qwen3.8-27b

# Comma-separated browser origins allowed to call the API (the React dev server by default).
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL (document metadata, chat history, evaluation results). Vectors stay in ChromaDB.
# Either set the parts below, or one DATABASE_URL (it wins when both are set).
DB_USER=postgres
DB_PASSWORD=your-postgres-password-here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=document_qa_bot
# DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/document_qa_bot
# DB_INIT_ON_STARTUP=true     # create the database and missing tables when the API starts
# Only used by the PostgreSQL tests (pytest -m postgres); every table in it is dropped:
# TEST_DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/document_qa_bot_test
